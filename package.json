{
  "name": "music-enhancer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "test:browser": "npm run build && node scripts/inspect-browser.mjs",
    "test:library-view": "npm run build && node scripts/check-library-view.mjs",
    "test:settings-search": "npm run build && node scripts/check-settings-search.mjs",
    "test:player-size": "npm run build && node scripts/check-player-size.mjs",
    "test:scrollbars": "npm run build && node scripts/check-scrollbars.mjs",
    "test:sidebar-layout": "npm run build && node scripts/check-sidebar-layout.mjs",
    "test:context-menus": "npm run build && node scripts/check-context-menus.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.4",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
